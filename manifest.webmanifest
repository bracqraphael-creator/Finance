{
  "name": "Pécule — mes comptes",
  "short_name": "Pécule",
  "description": "Vos comptes et vos placements, sur votre téléphone, sans donner l'accès à votre banque.",
  "lang": "fr",
  "id": "./",
  "start_url": "./#/accueil",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#edf0ec",
  "theme_color": "#edf0ec",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": [".pdf", "application/pdf", ".csv", ".ofx", ".qfx", ".qif", ".txt", "text/csv", "text/comma-separated-values", "text/plain", "application/x-ofx", "application/octet-stream"] }
      ]
    }
  },
  "file_handlers": [
    { "action": "./#/import", "accept": { "application/pdf": [".pdf"], "text/csv": [".csv"], "application/x-ofx": [".ofx", ".qfx"], "application/qif": [".qif"] } }
  ]
}
